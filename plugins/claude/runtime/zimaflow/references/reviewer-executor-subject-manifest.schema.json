{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo://references/reviewer-executor-subject-manifest.schema.json",
  "title": "Reviewer-Executor Canonical Verification Subject Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "normalization_version",
    "change_id",
    "objective_id",
    "required_task_ids",
    "subjects"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "normalization_version": {"const": 1},
    "change_id": {"type": "string", "minLength": 1},
    "objective_id": {"type": "string", "minLength": 1},
    "required_task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)*$"}
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject_id",
          "kind",
          "refs",
          "semantic_inputs",
          "required_evidence",
          "verification_contract"
        ],
        "properties": {
          "subject_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^repo://"}
          },
          "semantic_inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "properties": {
                "path": {"type": "string", "pattern": "^repo://"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          },
          "requirement_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "scenario_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "spec_pairs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requirement_id", "scenario_id"],
              "properties": {
                "requirement_id": {"type": "string", "minLength": 1},
                "scenario_id": {"type": "string", "minLength": 1}
              }
            }
          },
          "boundary_id": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "invariant": {"type": "string", "minLength": 1},
          "required_evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "verification_contract": {
            "type": "object",
            "minProperties": 1
          },
          "metadata": {"type": "object"}
        }
      }
    },
    "metadata": {"type": "object"}
  }
}
