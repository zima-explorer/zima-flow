{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zimaflow Golden Eval Protocol",
  "description": "Public documentation of version 1. Runtime validation uses Python standard library only.",
  "oneOf": [
    {
      "title": "Golden Case",
      "type": "object",
      "required": ["schema_version", "case_id", "title", "tags", "fixture", "task", "expected", "prohibited_outcomes", "required_evidence", "evaluation_mode"],
      "properties": {
        "schema_version": {"const": 1},
        "case_id": {"type": "string"},
        "title": {"type": "string"},
        "tags": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "fixture": {"type": "object", "required": ["root", "inputs"]},
        "task": {"type": "string"},
        "expected": {"type": "object", "required": ["assertions"]},
        "prohibited_outcomes": {"type": "array", "items": {"type": "string"}},
        "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evaluation_mode": {"enum": ["mechanical", "semantic_review_required"]}
      }
    },
    {
      "title": "Eval Receipt",
      "type": "object",
      "required": ["schema_version", "case_id", "case_digest", "fixture_digest", "executor", "assertions", "artifacts", "evidence", "result"],
      "properties": {
        "schema_version": {"const": 1},
        "case_id": {"type": "string"},
        "case_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fixture_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "executor": {"type": "object", "required": ["host", "protocol_version"]},
        "assertions": {"type": "array"},
        "artifacts": {"type": "array"},
        "evidence": {"type": "array"},
        "result": {"enum": ["passed", "failed", "inconclusive"]}
      }
    }
  ]
}
