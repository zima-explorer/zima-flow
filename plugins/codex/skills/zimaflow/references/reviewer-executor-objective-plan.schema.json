{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo://references/reviewer-executor-objective-plan.schema.json",
  "title": "Reviewer-Executor Objective Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "change_id", "required_objectives"],
  "properties": {
    "schema_version": {"const": 1},
    "change_id": {"type": "string", "minLength": 1},
    "required_objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objective_id",
          "order",
          "purpose",
          "required",
          "required_task_ids",
          "manifest"
        ],
        "properties": {
          "objective_id": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 1},
          "purpose": {"type": "string", "minLength": 1},
          "required": {"const": true},
          "required_task_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)*$"}
          },
          "manifest": {"type": "string", "pattern": "^repo://"},
          "remediates": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "metadata": {"type": "object"}
        }
      }
    },
    "metadata": {"type": "object"}
  }
}
