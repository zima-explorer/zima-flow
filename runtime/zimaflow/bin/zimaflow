    printf '  path: %s\n' "$STATE_CONTRACT_PATH"
    printf '  status: %s\n' "$STATE_CONTRACT_STATUS"
    printf '  confirmed_at: %s\n' "$STATE_CONTRACT_CONFIRMED_AT"
    printf '\n'
    printf 'decision:\n'
    printf '  path: %s\n' "$STATE_DECISION_PATH"
    printf '  status: %s\n' "$STATE_DECISION_STATUS"
    printf '\n'
