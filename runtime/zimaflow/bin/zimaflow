  [ -n "$STATE_PROPOSAL_PATH" ] || STATE_PROPOSAL_PATH="openspec/changes/$change/proposal.md"
  [ -n "$STATE_DESIGN_PATH" ] || STATE_DESIGN_PATH="openspec/changes/$change/design.md"
  [ -n "$STATE_TASKS_PATH" ] || STATE_TASKS_PATH="openspec/changes/$change/tasks.md"
  [ -n "$STATE_SPEC_REVIEW_CONFIRMED" ] || STATE_SPEC_REVIEW_CONFIRMED="false"
  [ -n "$STATE_OPSX_VERIFY" ] || STATE_OPSX_VERIFY="not_run"
  [ -n "$STATE_FULL_TESTS" ] || STATE_FULL_TESTS="not_run"
  [ -n "$STATE_ARCHIVE_STATUS" ] || STATE_ARCHIVE_STATUS="not_archived"
  [ -n "$STATE_DOCS_SYNCED" ] || STATE_DOCS_SYNCED="false"
  [ -n "$STATE_EXECUTION_INPUT_STATUS" ] || STATE_EXECUTION_INPUT_STATUS="not_applicable"
}

