    STATE_EXECUTION_INPUT_CONFIRMED_AT="$(yaml_nested_value "$file" "execution_input" "confirmed_at")"
  fi

  [ -n "$STATE_CONTRACT_STATUS" ] || STATE_CONTRACT_STATUS="confirmed"
  [ -n "$STATE_DECISION_STATUS" ] || STATE_DECISION_STATUS="confirmed"
  [ -n "$STATE_PROTOTYPE_ENABLED" ] || STATE_PROTOTYPE_ENABLED="false"
  [ -n "$STATE_PROTOTYPE_STATUS" ] || STATE_PROTOTYPE_STATUS="not_applicable"
