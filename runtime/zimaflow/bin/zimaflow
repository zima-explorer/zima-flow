    printf '  prototype_path: %s\n' "$STATE_PROTOTYPE_PATH"
    printf '  review_notes_path: %s\n' "$STATE_REVIEW_NOTES_PATH"
    printf '  status: %s\n' "$STATE_PROTOTYPE_STATUS"
    printf '\n'
