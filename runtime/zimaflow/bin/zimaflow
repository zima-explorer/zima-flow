#!/usr/bin/env bash
set -u

VERSION="1.22.4"
ZIMAFLOW_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
zimaflow - lightweight workflow guardrails

Usage:
  zimaflow close [--json]
  zimaflow state [--json]
  zimaflow state init <change> [options]
  zimaflow state update <change> [options]
  zimaflow project init [--name NAME] [--docs-root PATH] [--json]
  zimaflow project show [--docs-root PATH] [--json]
  zimaflow recall [--json] [--days N] [--summary-lines N]
  zimaflow recall --project <name> [--json] [--days N] [--summary-lines N]
  zimaflow recall --all [--json] [--days N] [--summary-lines N]
  zimaflow release-check [--json]
  zimaflow context-check [--json]
  zimaflow stale-review [--json] [--days N] [--include-rules]
  zimaflow knowledge-record --knowledge-id ID --event-type TYPE [options]
  zimaflow drift-check <change> [--json] [--write]
  zimaflow execution-input <change> --write [--json]
  zimaflow host-profile <host> [--json]
  zimaflow doctor <host> [--json] [options]
  zimaflow runtime install|upgrade|repair|remove <host> --install-root <temporary-root> [--desired-version VERSION] [--json]
  zimaflow install-hooks [--strict]
  zimaflow --help

Commands:
  close                 Run a lightweight session close checklist.
  close --json          Emit a stable JSON checklist for agents and tools.
  state                 Show per-change .zimaflow-state.yaml summaries.
  state --json          Emit state summaries as JSON.
  state init <change>   Create openspec/changes/<change>/.zimaflow-state.yaml.
  state update <change> Update selected fields in an existing state file.
  project init          Create the portable .zimaflow/project.yaml contract.
  project show          Resolve project/docs context without writing files.
  recall                Summarize active changes + bit-rot to pick work back up.
  recall --json         Emit the recall summary as JSON.
  recall --days N       Bit-rot threshold in days (default 30).
  recall --summary-lines N
                        Max handover summary lines per change (default 8).
  recall --project <name>
                        Recall one registered project by name (no cd needed).
  recall --all          Cross-project overview from ~/.zimaflow/projects.yaml.
                        --summary-lines N opts into per-change handover summaries.
                        ZIMAFLOW_PROJECT_REGISTRY explicitly enables legacy Markdown input.
  release-check         Pre-release readiness checklist + 4 human-confirm questions.
  release-check --json  Emit the release readiness summary as JSON.
  context-check         Check thin context-index baseline/workflow references.
  context-check --json  Emit the context-index check as JSON.
  stale-review          List knowledge entries with no recent cited/applied usage.
  stale-review --json   Emit stale-review candidates as JSON.
  knowledge-record      Append one validated event to the global knowledge ledger.
  drift-check <change>  Compare artifact hashes stored in .zimaflow-state.yaml.
  drift-check --write   Write or refresh artifact hash baselines.
  execution-input       Write a derived implementation-input snapshot for a full/hotfix change.
  host-profile          Report host discovery and packaging capabilities.
  doctor                Read-only host capability diagnostic with resumable intent.
  runtime               Manage a generated host runtime under an explicit temporary root.
  install-hooks         Install non-blocking git hook reminders.
  install-hooks --strict
                        Reserved for future blocking checks; currently installs reminders only.

State options:
  --phase <phase>
  --mode <mode>
  --contract <path>
  --decision <path>
  --branch <branch>
  --worktree <path>
  --verify <status>
  --full-tests <status>
  --last-command <command>
  --last-result <result>
  --evidence-path <path-or-url>
  --blocked-reason <reason>
  --archive-status <status>
  --handover <path>

Doctor options:
  --json
  --project <path>
  --capability <logical-capability-id>
  --intent <raw-user-intent>
  --dispatch-context <context>
  --cli-path <path>
  --cli-version <version>
  --protocol-version <version>
  --runtime-manifest <path>
  --permission-status <granted|denied>
EOF
}

find_git_root() {
  git rev-parse --show-toplevel 2>/dev/null
}

find_state_root() {
  if [ -d "openspec/changes" ]; then
    pwd
    return 0
  fi
  find_git_root
}

json_escape() {
  sed \
    -e 's/\\/\\\\/g' \
    -e 's/"/\\"/g' \
    -e 's/	/\\t/g'
}

json_string() {
  printf '"%s"' "$(printf '%s' "$1" | json_escape)"
}

json_string_array() {
  local lines="$1"
  local first="yes"
  printf '['
  if [ -n "$lines" ]; then
    while IFS= read -r line; do
      if [ "$first" = "no" ]; then
        printf ','
      fi
      json_string "$line"
      first="no"
    done <<EOF
$lines
EOF
  fi
  printf ']'
}

yaml_clean_value() {
  sed \
    -e 's/^"//' \
    -e 's/"$//' \
    -e "s/^'//" \
    -e "s/'$//"
}

yaml_top_value() {
  local file="$1"
  local key="$2"
  awk -v key="$key:" '
    $1 == key {
      sub("^[[:space:]]*" key "[[:space:]]*", "")
      print
      exit
    }
  ' "$file" 2>/dev/null | yaml_clean_value
}

yaml_nested_value() {
  local file="$1"
  local section="$2"
  local key="$3"
  awk -v section="$section:" -v key="$key:" '
    $1 == section { in_section = 1; next }
    in_section && $0 !~ /^[[:space:]]/ { in_section = 0 }
    in_section && $1 == key {
      sub("^[[:space:]]*" key "[[:space:]]*", "")
      print
      exit
    }
  ' "$file" 2>/dev/null | yaml_clean_value
}

find_zimaflow_home() {
  if [ -n "${ZIMAFLOW_HOME:-}" ] && [ -f "$ZIMAFLOW_HOME/references/host-capabilities.yaml" ]; then
    printf '%s' "$ZIMAFLOW_HOME"
    return 0
  fi

  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  cd "$script_dir/.." && pwd
}

canonical_path_for_write() {
  local requested="$1"
  local probe="$requested"
  local suffix=""

  while [ ! -e "$probe" ] && [ "$probe" != "/" ]; do
    if [ -n "$suffix" ]; then
      suffix="$(basename "$probe")/$suffix"
    else
      suffix="$(basename "$probe")"
    fi
    probe="$(dirname "$probe")"
  done

  [ -d "$probe" ] || return 1
  local canonical
  canonical="$(cd "$probe" 2>/dev/null && pwd -P)" || return 1
  if [ -n "$suffix" ]; then
    printf '%s/%s' "${canonical%/}" "$suffix"
  else
    printf '%s' "$canonical"
  fi
}

validate_project_name() {
  case "$1" in
    ""|*[!A-Za-z0-9._-]*|[.-]*|*..*) return 1 ;;
    *) return 0 ;;
  esac
}

validate_safe_relative_path() {
  case "$1" in
    ""|/*|"~"|"~"/*|./*|*/./*|*/.|..|../*|*/../*|*/..|*//*) return 1 ;;
    *) return 0 ;;
  esac
}

validate_absolute_path_shape() {
  case "$1" in
    ""|./*|*/./*|*/.|..|../*|*/../*|*/..|*//*) return 1 ;;
    /*|"~"|"~"/*) return 0 ;;
    *) return 1 ;;
  esac
}

expand_user_path() {
  local value="$1"
  validate_absolute_path_shape "$value" || return 1
  case "$value" in
    "~") [ -n "${HOME:-}" ] || return 1; printf '%s' "$HOME" ;;
    "~/"*) [ -n "${HOME:-}" ] || return 1; printf '%s/%s' "${HOME%/}" "${value#\~/}" ;;
    /*) printf '%s' "$value" ;;
  esac
}

resolve_projects_file() {
  local requested
  if [ "${ZIMAFLOW_PROJECTS_FILE+x}" = "x" ]; then
    requested="$ZIMAFLOW_PROJECTS_FILE"
    case "$requested" in /*) ;; *) echo "ZIMAFLOW_PROJECTS_FILE must be an absolute path." >&2; return 2 ;; esac
  else
    [ -n "${HOME:-}" ] || { echo "HOME is required when ZIMAFLOW_PROJECTS_FILE is not set." >&2; return 2; }
    requested="$HOME/.zimaflow/projects.yaml"
  fi
  if [ -f "$requested" ]; then
    local parent
    parent="$(cd "$(dirname "$requested")" 2>/dev/null && pwd -P)" || {
      echo "Unable to resolve projects file: $requested" >&2
      return 2
    }
    printf '%s/%s' "$parent" "$(basename "$requested")"
  else
    canonical_path_for_write "$requested" || { echo "Unable to resolve projects file: $requested" >&2; return 2; }
  fi
}

project_manifest_row() {
  local file="$1"
  awk '
    function clean(v, f, l) {
      sub(/^[[:space:]]+/, "", v); sub(/[[:space:]]+$/, "", v)
      f = substr(v, 1, 1); l = substr(v, length(v), 1)
      if ((f == "\"" && l == "\"") || (f == "\047" && l == "\047")) v = substr(v, 2, length(v) - 2)
      return v
    }
    /^[[:space:]]*($|#)/ { next }
    /^[[:space:]]/ { bad = 1; next }
    {
      key = $0; sub(/:.*/, "", key)
      value = $0; sub(/^[^:]*:[[:space:]]*/, "", value)
      if (key != "schema_version" && key != "name" && key != "docs_root") { bad = 1; next }
      if (seen[key]++) { bad = 1; next }
      values[key] = clean(value)
    }
    END {
      if (bad || !seen["schema_version"] || !seen["name"] || !seen["docs_root"] || values["schema_version"] != "1") exit 2
      printf "%s\t%s\t%s\n", values["schema_version"], values["name"], values["docs_root"]
    }
  ' "$file" 2>/dev/null || { echo "Invalid project manifest: $file" >&2; return 2; }
}

project_manifest_value() {
  local file="$1" key="$2" row schema name docs_root
  row="$(project_manifest_row "$file")" || return
  IFS=$'\t' read -r schema name docs_root <<EOF
$row
EOF
  case "$key" in
    schema_version) printf '%s' "$schema" ;;
    name) printf '%s' "$name" ;;
    docs_root) printf '%s' "$docs_root" ;;
    *) return 2 ;;
  esac
}

projects_registry_entries() {
  local file="$1"
  [ -f "$file" ] || return 0
  awk '
    function clean(v, f, l) {
      sub(/^[[:space:]]+/, "", v); sub(/[[:space:]]+$/, "", v)
      f = substr(v, 1, 1); l = substr(v, length(v), 1)
      if ((f == "\"" && l == "\"") || (f == "\047" && l == "\047")) v = substr(v, 2, length(v) - 2)
      return v
    }
    function emit() {
      if (!in_entry) return
      if (!has_name || !has_code || !has_docs || !has_status) { bad = 1; return }
      printf "%s\t%s\t%s\t%s\n", name, code_root, docs_root, status
    }
    /^[[:space:]]*($|#)/ { next }
    /^schema_version:[[:space:]]*/ {
      if (seen_schema++) { bad = 1; next }
      v = $0; sub(/^[^:]*:[[:space:]]*/, "", v); if (clean(v) != "1") bad = 1
      next
    }
    /^projects:[[:space:]]*$/ { if (seen_projects++) bad = 1; next }
    /^  - name:[[:space:]]*/ {
      emit(); in_entry = 1; delete seen_field
      has_name = has_code = has_docs = has_status = 0
      v = $0; sub(/^  - name:[[:space:]]*/, "", v); name = clean(v)
      has_name = 1; seen_field["name"] = 1; next
    }
    /^    (code_root|docs_root|status):[[:space:]]*/ {
      if (!in_entry) { bad = 1; next }
      key = $0; sub(/^    /, "", key); sub(/:.*/, "", key)
      if (seen_field[key]++) { bad = 1; next }
      v = $0; sub(/^    [^:]*:[[:space:]]*/, "", v); v = clean(v)
      if (key == "code_root") { code_root = v; has_code = 1 }
      if (key == "docs_root") { docs_root = v; has_docs = 1 }
      if (key == "status") { status = v; has_status = 1 }
      next
    }
    { bad = 1 }
    END { emit(); if (bad || !seen_schema || !seen_projects) exit 2 }
  ' "$file" || { echo "Invalid projects registry: $file" >&2; return 2; }
}

resolve_project_context() {
  local requested_root="${1:-}" cli_docs_root="${2:-}"
  local code_root project_config projects_file initialized project_name project_docs_root
  local docs_root docs_root_source manifest_row schema
  [ -n "$requested_root" ] || requested_root="$(find_git_root 2>/dev/null || true)"
  [ -n "$requested_root" ] && [ -d "$requested_root" ] || { echo "Not inside a git repository." >&2; return 2; }
  code_root="$(cd "$requested_root" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)" || { echo "Not inside a git repository." >&2; return 2; }
  code_root="$(cd "$code_root" && pwd -P)"
  project_config="$code_root/.zimaflow/project.yaml"
  projects_file="$(resolve_projects_file)" || return
  initialized=false
  project_name="$(basename "$code_root")"
  project_docs_root="docs/zimaflow"

  if [ -f "$project_config" ]; then
    manifest_row="$(project_manifest_row "$project_config")" || return
    IFS=$'\t' read -r schema project_name project_docs_root <<EOF
$manifest_row
EOF
    validate_project_name "$project_name" || { echo "Invalid project name in manifest: $project_name" >&2; return 2; }
    validate_safe_relative_path "$project_docs_root" || { echo "Invalid docs_root in project manifest: $project_docs_root" >&2; return 2; }
    initialized=true
  fi

  docs_root="$(canonical_path_for_write "$code_root/$project_docs_root")" || return 2
  docs_root_source=project
  [ "$initialized" = true ] || docs_root_source=default

  if [ -f "$projects_file" ]; then
    local entries entry_name entry_code entry_docs entry_status expanded_code expanded_docs name_match_docs=""
    entries="$(projects_registry_entries "$projects_file")" || return
    while IFS=$'\t' read -r entry_name entry_code entry_docs entry_status; do
      [ -n "$entry_name" ] || continue
      validate_project_name "$entry_name" || { echo "Invalid project name in registry: $entry_name" >&2; return 2; }
      case "$entry_status" in active|inactive) ;; *) echo "Invalid project status in registry: $entry_status" >&2; return 2 ;; esac
      expanded_code="$(expand_user_path "$entry_code")" || { echo "Invalid code_root in registry: $entry_code" >&2; return 2; }
      expanded_docs="$(expand_user_path "$entry_docs")" || { echo "Invalid docs_root in registry: $entry_docs" >&2; return 2; }
      expanded_code="$(canonical_path_for_write "$expanded_code")" || return 2
      expanded_docs="$(canonical_path_for_write "$expanded_docs")" || return 2
      if [ "$entry_status" = active ] && [ "$expanded_code" = "$code_root" ]; then
        docs_root="$expanded_docs"; docs_root_source=user; name_match_docs=""; break
      fi
      if [ "$entry_status" = active ] && [ -z "$name_match_docs" ] && [ "$(printf '%s' "$entry_name" | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "$project_name" | tr '[:upper:]' '[:lower:]')" ]; then
        name_match_docs="$expanded_docs"
      fi
    done <<EOF
$entries
EOF
    if [ "$docs_root_source" != user ] && [ -n "$name_match_docs" ]; then docs_root="$name_match_docs"; docs_root_source=user; fi
  fi

  if [ -n "$cli_docs_root" ]; then
    local expanded_cli
    case "$cli_docs_root" in
      /*|"~"|"~"/*) expanded_cli="$(expand_user_path "$cli_docs_root")" || { echo "Invalid --docs-root: $cli_docs_root" >&2; return 2; } ;;
      *) validate_safe_relative_path "$cli_docs_root" || { echo "Invalid --docs-root: $cli_docs_root" >&2; return 2; }; expanded_cli="$code_root/$cli_docs_root" ;;
    esac
    docs_root="$(canonical_path_for_write "$expanded_cli")" || return 2
    docs_root_source=cli
  fi

  printf '1\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$project_name" "$code_root" "$docs_root" "$project_config" "$projects_file" "$docs_root_source" "$initialized"
}

print_project_json() {
  local context="$1" written="${2:-}" schema project_name code_root docs_root project_config projects_file docs_root_source initialized
  IFS=$'\t' read -r schema project_name code_root docs_root project_config projects_file docs_root_source initialized <<EOF
$context
EOF
  printf '{"schema_version":%s,"project_name":' "$schema"; json_string "$project_name"
  printf ',"code_root":'; json_string "$code_root"
  printf ',"docs_root":'; json_string "$docs_root"
  printf ',"project_config":'; json_string "$project_config"
  printf ',"projects_file":'; json_string "$projects_file"
  printf ',"docs_root_source":'; json_string "$docs_root_source"
  printf ',"initialized":%s' "$initialized"
  [ -z "$written" ] || printf ',"written":%s' "$written"
  printf '}\n'
}

print_project_human() {
  local context="$1" written="${2:-}" schema project_name code_root docs_root project_config projects_file docs_root_source initialized
  IFS=$'\t' read -r schema project_name code_root docs_root project_config projects_file docs_root_source initialized <<EOF
$context
EOF
  echo "Zimaflow project: $project_name"
  echo "Code root: $code_root"
  echo "Docs root: $docs_root ($docs_root_source)"
  echo "Project config: $project_config"
  echo "Projects file: $projects_file"
  echo "Initialized: $initialized"
  [ -z "$written" ] || echo "Written: $written"
  [ "$initialized" = true ] || echo "Next action: zimaflow project init"
}

run_project() {
  local action="${1:-}"
  shift || true
  case "$action" in init|show) ;; *) echo "Unknown project action: $action" >&2; return 2 ;; esac
  local format=human name="" docs_override=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) format=json; shift ;;
      --name) [ "$action" = init ] && [ "$#" -ge 2 ] || { echo "--name is valid only for project init." >&2; return 2; }; name="$2"; shift 2 ;;
      --docs-root) [ "$#" -ge 2 ] || { echo "--docs-root requires a value." >&2; return 2; }; docs_override="$2"; shift 2 ;;
      *) echo "Unknown project option: $1" >&2; return 2 ;;
    esac
  done

  local root project_config context written=false
  root="$(find_git_root)" || { echo "Not inside a git repository." >&2; return 2; }
  root="$(cd "$root" && pwd -P)"
  project_config="$root/.zimaflow/project.yaml"
  if [ "$action" = init ] && [ ! -f "$project_config" ]; then
    [ -n "$name" ] || name="$(basename "$root")"
    [ -n "$docs_override" ] || docs_override="docs/zimaflow"
    validate_project_name "$name" || { echo "Invalid project name: $name" >&2; return 2; }
    validate_safe_relative_path "$docs_override" || { echo "Invalid committed docs_root: $docs_override" >&2; return 2; }
    mkdir -p "$root/.zimaflow" "$root/$docs_override" || return 2
    local temp_manifest
    temp_manifest="$(mktemp "$root/.zimaflow/project.yaml.tmp.XXXXXX")" || return 2
    { printf 'schema_version: 1\n'; printf 'name: %s\n' "$name"; printf 'docs_root: %s\n' "$docs_override"; } > "$temp_manifest"
    chmod 644 "$temp_manifest"
    mv "$temp_manifest" "$project_config"
    written=true
  fi
  local context_docs_override="$docs_override"
  [ "$action" = init ] && context_docs_override=""
  context="$(resolve_project_context "$root" "$context_docs_override")" || return
  if [ "$format" = json ]; then
    if [ "$action" = init ]; then print_project_json "$context" "$written"; else print_project_json "$context"; fi
  else
    if [ "$action" = init ]; then print_project_human "$context" "$written"; else print_project_human "$context"; fi
  fi
}

resolve_knowledge_data_home() {
  local requested
  if [ "${ZIMAFLOW_DATA_HOME+x}" = "x" ]; then
    requested="$ZIMAFLOW_DATA_HOME"
  else
    if [ -z "${HOME:-}" ]; then
      echo "HOME is required when ZIMAFLOW_DATA_HOME is not set." >&2
      return 2
    fi
    requested="$HOME/.zimaflow/data"
  fi
  case "$requested" in
    ""|/*/../*|*/..|/*/./*|*/.|*//* )
      echo "Unsafe ZIMAFLOW_DATA_HOME path." >&2
      return 2
      ;;
    /*) ;;
    *)
      echo "ZIMAFLOW_DATA_HOME must be an absolute path." >&2
      return 2
      ;;
  esac

  local resolved home_resolved capability_root
  resolved="$(canonical_path_for_write "$requested")" || {
    echo "Cannot resolve ZIMAFLOW_DATA_HOME." >&2
    return 2
  }
  home_resolved="$(canonical_path_for_write "${HOME:-/}")" || home_resolved="${HOME:-/}"
  capability_root="$(find_zimaflow_home)"
  capability_root="$(cd "$capability_root" 2>/dev/null && pwd -P)" || return 2

  case "$resolved" in
    /|"$home_resolved"|"$capability_root"|"$capability_root"/*)
      echo "Unsafe ZIMAFLOW_DATA_HOME path." >&2
      return 2
      ;;
  esac

  local ancestor="$resolved"
  while [ "$ancestor" != "/" ]; do
    if [ -f "$ancestor/.claude-plugin/plugin.json" ] \
      || [ -f "$ancestor/.codex-plugin/plugin.json" ] \
      || [ -f "$ancestor/runtime-manifest.yaml" ]; then
      echo "ZIMAFLOW_DATA_HOME cannot be inside a generated Plugin/runtime." >&2
      return 2
    fi
    ancestor="$(dirname "$ancestor")"
  done

  printf '%s' "$resolved"
}

valid_knowledge_record_value() {
  local value="$1"
  [ -n "$value" ] || return 1
  case "$value" in
    *$'\n'*|*$'\r'*) return 1 ;;
  esac
  if printf '%s' "$value" | LC_ALL=C grep -q '[[:cntrl:]]'; then
    return 1
  fi
}

run_knowledge_record() {
  local knowledge_id=""
  local event_type=""
  local project=""
  local session=""
  local stage=""
  local trigger=""
  local reason=""
  local format="human"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --knowledge-id|--event-type|--project|--session|--stage|--trigger|--reason)
        [ "${2+x}" ] || { echo "Missing value for $1" >&2; return 2; }
        case "$1" in
          --knowledge-id) knowledge_id="$2" ;;
          --event-type) event_type="$2" ;;
          --project) project="$2" ;;
          --session) session="$2" ;;
          --stage) stage="$2" ;;
          --trigger) trigger="$2" ;;
          --reason) reason="$2" ;;
        esac
        shift 2
        ;;
      --json)
        format="json"
        shift
        ;;
      *)
        echo "Unknown knowledge-record option: $1" >&2
        return 2
        ;;
    esac
  done

  local field value
  for field in knowledge_id event_type project session stage trigger reason; do
    case "$field" in
      knowledge_id) value="$knowledge_id" ;;
      event_type) value="$event_type" ;;
      project) value="$project" ;;
      session) value="$session" ;;
      stage) value="$stage" ;;
      trigger) value="$trigger" ;;
      reason) value="$reason" ;;
    esac
    if ! valid_knowledge_record_value "$value"; then
      echo "Missing or invalid knowledge-record field: $field" >&2
      return 2
    fi
  done
  case "$event_type" in
    loaded|cited|applied|challenged|stale_review) ;;
    *)
      echo "Invalid knowledge event type: $event_type" >&2
      return 2
      ;;
  esac

  local data_home
  data_home="$(resolve_knowledge_data_home)" || return $?
  if [ -e "$data_home" ] && [ ! -d "$data_home" ]; then
    echo "ZIMAFLOW_DATA_HOME is not a directory." >&2
    return 2
  fi

  umask 077
  mkdir -p "$data_home" || {
    echo "Cannot create ZIMAFLOW_DATA_HOME." >&2
    return 1
  }
  chmod 700 "$data_home" || {
    echo "Cannot secure ZIMAFLOW_DATA_HOME." >&2
    return 1
  }

  local ledger_path="$data_home/knowledge-usage-ledger.jsonl"
  local lessons_path="$data_home/lessons-common.md"
  local lock_path="$data_home/.knowledge-usage-ledger.lock"
  if ! mkdir "$lock_path" 2>/dev/null; then
    echo "Knowledge ledger is locked by another writer." >&2
    return 1
  fi

  if [ -L "$ledger_path" ] || { [ -e "$ledger_path" ] && [ ! -f "$ledger_path" ]; }; then
    rmdir "$lock_path" 2>/dev/null || true
    echo "Knowledge ledger path is not a regular file." >&2
    return 1
  fi
  if [ -L "$lessons_path" ] || { [ -e "$lessons_path" ] && [ ! -f "$lessons_path" ]; }; then
    rmdir "$lock_path" 2>/dev/null || true
    echo "User lessons path is not a regular file." >&2
    return 1
  fi
  if [ ! -e "$lessons_path" ]; then
    local lessons_tmp
    lessons_tmp="$(mktemp "$data_home/.lessons-common.XXXXXX")" || {
      rmdir "$lock_path" 2>/dev/null || true
      echo "Cannot initialize user lessons." >&2
      return 1
    }
    printf '# Cross-project lessons\n\n' > "$lessons_tmp"
    chmod 600 "$lessons_tmp"
    mv "$lessons_tmp" "$lessons_path" || {
      rm -f "$lessons_tmp"
      rmdir "$lock_path" 2>/dev/null || true
      echo "Cannot initialize user lessons." >&2
      return 1
    }
  fi

  local timestamp event_id event_json nonce_file nonce
  timestamp="$(now_iso | sed -E 's/([+-][0-9]{2})([0-9]{2})$/\1:\2/')"
  nonce_file="$(mktemp "$data_home/.knowledge-event.XXXXXX")" || {
    rmdir "$lock_path" 2>/dev/null || true
    echo "Cannot allocate a unique knowledge event ID." >&2
    return 1
  }
  nonce="$(basename "$nonce_file")"
  nonce="${nonce#.knowledge-event.}"
  rm -f "$nonce_file"
  event_id="use-$(date '+%Y%m%d')-$(now_epoch)-$$-$nonce"
  event_json="$(
    printf '{"event_id":'; json_string "$event_id"
    printf ',"knowledge_id":'; json_string "$knowledge_id"
    printf ',"event_type":'; json_string "$event_type"
    printf ',"project":'; json_string "$project"
    printf ',"session":'; json_string "$session"
    printf ',"stage":'; json_string "$stage"
    printf ',"trigger":'; json_string "$trigger"
    printf ',"reason":'; json_string "$reason"
    printf ',"timestamp":'; json_string "$timestamp"
    printf '}'
  )"

  if ! { : >> "$ledger_path" && chmod 600 "$ledger_path" && printf '%s\n' "$event_json" >> "$ledger_path"; }; then
    rmdir "$lock_path" 2>/dev/null || true
    echo "Cannot append knowledge usage event." >&2
    return 1
  fi
  rmdir "$lock_path" 2>/dev/null || {
    echo "Cannot release knowledge ledger lock." >&2
    return 1
  }

  if [ "$format" = "json" ]; then
    printf '{"written":true,"event_id":'; json_string "$event_id"
    printf ',"ledger_path":'; json_string "$ledger_path"
    printf ',"event_type":'; json_string "$event_type"
    printf ',"knowledge_id":'; json_string "$knowledge_id"
    printf '}\n'
    return 0
  fi

  echo "Zimaflow knowledge record"
  echo
  echo "Written: yes"
  printf 'Event ID: %s\n' "$event_id"
  printf 'Event type: %s\n' "$event_type"
  printf 'Knowledge ID: %s\n' "$knowledge_id"
  printf 'Ledger: %s\n' "$ledger_path"
}

json_bool_or_string() {
  case "$1" in
    true|false) printf '%s' "$1" ;;
    *) json_string "$1" ;;
  esac
}

json_csv_array() {
  local values="$1"
  local first="yes"
  local value
  local old_ifs="$IFS"
  IFS=','
  printf '['
  for value in $values; do
    [ -n "$value" ] || continue
    if [ "$first" = "no" ]; then
      printf ','
    fi
    json_string "$value"
    first="no"
  done
  printf ']'
  IFS="$old_ifs"
}

run_host_profile() {
  local host="${1:-}"
  shift || true

  case "$host" in
    codex|workbuddy|claude-code) ;;
    "")
      echo "Missing host. Available hosts: codex, workbuddy, claude-code" >&2
      return 2
      ;;
    *)
      echo "Unknown host: $host. Available hosts: codex, workbuddy, claude-code" >&2
      return 2
      ;;
  esac

  local output_mode="human"
  if [ "${1:-}" = "--json" ]; then
    output_mode="json"
    shift
  fi
  if [ "$#" -gt 0 ]; then
    echo "Unknown host-profile option: $1" >&2
    return 2
  fi

  local zimaflow_home profile_file
  zimaflow_home="$(find_zimaflow_home)"
  profile_file="$zimaflow_home/references/host-capabilities.yaml"
  if [ ! -f "$profile_file" ]; then
    echo "Host capability profile not found: $profile_file" >&2
    return 2
  fi

  local schema_version canonical_source logical_skill_ids host_paths_in_core
  local support_tier evidence_status discovery_mode skill_entry_layout
  local nested_project_scopes arbitrary_root_recursion symlink_entry
  local packaging_preferred packaging_fallbacks evidence_url

  schema_version="$(yaml_top_value "$profile_file" "schema_version")"
  canonical_source="$(yaml_nested_value "$profile_file" "core" "canonical_source")"
  logical_skill_ids="$(yaml_nested_value "$profile_file" "core" "logical_skill_ids")"
  host_paths_in_core="$(yaml_nested_value "$profile_file" "core" "host_paths_in_core")"
  support_tier="$(yaml_nested_value "$profile_file" "$host" "support_tier")"
  evidence_status="$(yaml_nested_value "$profile_file" "$host" "evidence_status")"
  discovery_mode="$(yaml_nested_value "$profile_file" "$host" "discovery_mode")"
  skill_entry_layout="$(yaml_nested_value "$profile_file" "$host" "skill_entry_layout")"
  nested_project_scopes="$(yaml_nested_value "$profile_file" "$host" "nested_project_scopes")"
  arbitrary_root_recursion="$(yaml_nested_value "$profile_file" "$host" "arbitrary_root_recursion")"
  symlink_entry="$(yaml_nested_value "$profile_file" "$host" "symlink_entry")"
  packaging_preferred="$(yaml_nested_value "$profile_file" "$host" "packaging_preferred")"
  packaging_fallbacks="$(yaml_nested_value "$profile_file" "$host" "packaging_fallbacks")"
  evidence_url="$(yaml_nested_value "$profile_file" "$host" "evidence_url")"

  if [ "$schema_version" != "1" ]; then
    echo "Unsupported host capability schema version: ${schema_version:-missing}" >&2
    return 2
  fi

  if [ -z "$canonical_source" ] || \
     [ -z "$logical_skill_ids" ] || [ -z "$host_paths_in_core" ]; then
    echo "Invalid core host capability contract" >&2
    return 2
  fi

  if [ -z "$support_tier" ] || [ -z "$evidence_status" ] || \
     [ -z "$discovery_mode" ] || [ -z "$skill_entry_layout" ] || \
     [ -z "$nested_project_scopes" ] || [ -z "$arbitrary_root_recursion" ] || \
     [ -z "$symlink_entry" ] || [ -z "$packaging_preferred" ] || \
     [ -z "$evidence_url" ]; then
    echo "Invalid host capability profile for: $host" >&2
    return 2
  fi

  if [ "$output_mode" = "json" ]; then
    printf '{'
    printf '"schema_version":%s,' "$schema_version"
    printf '"host_id":'; json_string "$host"; printf ','
    printf '"support_tier":'; json_string "$support_tier"; printf ','
    printf '"evidence_status":'; json_string "$evidence_status"; printf ','
    printf '"discovery":{'
    printf '"mode":'; json_string "$discovery_mode"; printf ','
    printf '"skill_entry_layout":'; json_string "$skill_entry_layout"; printf ','
    printf '"nested_project_scopes":'; json_bool_or_string "$nested_project_scopes"; printf ','
    printf '"arbitrary_root_recursion":'; json_bool_or_string "$arbitrary_root_recursion"; printf ','
    printf '"symlink_entry":'; json_bool_or_string "$symlink_entry"
    printf '},'
    printf '"distribution":{'
    printf '"preferred":'; json_string "$packaging_preferred"; printf ','
    printf '"fallbacks":'; json_csv_array "$packaging_fallbacks"
    printf '},'
    printf '"core_contract":{'
    printf '"canonical_source":'; json_string "$canonical_source"; printf ','
    printf '"logical_skill_ids":'; json_bool_or_string "$logical_skill_ids"; printf ','
    printf '"host_paths_in_core":'; json_bool_or_string "$host_paths_in_core"
    printf '},'
    printf '"evidence_url":'; json_string "$evidence_url"
    printf '}\n'
    return 0
  fi

  echo "Zimaflow host profile"
  echo "Host: $host"
  echo "Support tier: $support_tier"
  echo "Evidence status: $evidence_status"
  echo "Discovery mode: $discovery_mode"
  echo "Packaging preferred: $packaging_preferred"
  echo "Fallbacks: ${packaging_fallbacks:-none}"
  echo "Canonical source: $canonical_source"
  echo "Evidence: $evidence_url"
}

doctor_gap_metadata() {
  case "$1" in
    cli_missing) echo "error|true|install_cli|true" ;;
    cli_version_incompatible) echo "error|true|upgrade_cli|true" ;;
    project_not_initialized) echo "error|true|initialize_project|true" ;;
    host_profile_missing) echo "error|true|restore_host_profile|true" ;;
    capability_unavailable) echo "error|true|make_capability_available|true" ;;
    runtime_missing) echo "error|true|install_runtime|true" ;;
    runtime_drift) echo "error|true|regenerate_runtime|true" ;;
    permission_denied) echo "error|true|grant_permission|false" ;;
    contract_incompatible) echo "error|true|align_contract|true" ;;
    *) return 2 ;;
  esac
}

doctor_add_check() {
  DOCTOR_CHECKS="${DOCTOR_CHECKS}${1}|${2}|${3}
"
}

doctor_has_gap() {
  local expected="$1"
  printf '%s' "$DOCTOR_GAPS" | awk -F '|' -v expected="$expected" '$1 == expected { found = 1 } END { exit !found }'
}

doctor_add_gap() {
  local code="$1"
  local metadata severity blocking remediation_type can_resume
  if doctor_has_gap "$code"; then
    return 0
  fi
  metadata="$(doctor_gap_metadata "$code")" || return 2
  IFS='|' read -r severity blocking remediation_type can_resume <<EOF
$metadata
EOF
  DOCTOR_GAPS="${DOCTOR_GAPS}${code}|${severity}|${blocking}|${remediation_type}|${can_resume}
"
  if [ "$can_resume" = "false" ]; then
    DOCTOR_AUTO_RESUME="false"
  fi
}

doctor_csv_contains() {
  local values="$1"
  local expected="$2"
  local item old_ifs="$IFS"
  IFS=','
  for item in $values; do
    if [ "$item" = "$expected" ]; then
      IFS="$old_ifs"
      return 0
    fi
  done
  IFS="$old_ifs"
  return 1
}

doctor_next_action() {
  if [ "$DOCTOR_OVERALL_STATUS" = "ready" ]; then
    if [ -n "$DOCTOR_INTENT" ]; then printf 'continue_original_intent'; else printf 'doctor_complete'; fi
    return 0
  fi
  if doctor_has_gap "project_not_initialized"; then printf 'initialize_project_then_resume_intent'; return 0; fi
  if doctor_has_gap "cli_missing"; then printf 'install_cli_then_resume_intent'; return 0; fi
  if doctor_has_gap "cli_version_incompatible"; then printf 'upgrade_cli_then_resume_intent'; return 0; fi
  if doctor_has_gap "host_profile_missing"; then printf 'restore_host_profile_then_resume_intent'; return 0; fi
  if doctor_has_gap "capability_unavailable"; then printf 'make_capability_available_then_resume_intent'; return 0; fi
  if doctor_has_gap "runtime_missing"; then printf 'install_runtime_then_resume_intent'; return 0; fi
  if doctor_has_gap "runtime_drift"; then printf 'regenerate_runtime_then_resume_intent'; return 0; fi
  if doctor_has_gap "permission_denied"; then printf 'request_permission_confirmation'; return 0; fi
  printf 'align_contract_then_resume_intent'
}

doctor_print_checks_json() {
  local first="yes" id status detail
  printf '['
  while IFS='|' read -r id status detail; do
    [ -n "$id" ] || continue
    if [ "$first" = "no" ]; then printf ','; fi
    printf '{"id":'; json_string "$id"; printf ',"status":'; json_string "$status"; printf ',"detail":'; json_string "$detail"; printf '}'
    first="no"
  done <<EOF
$DOCTOR_CHECKS
EOF
  printf ']'
}

doctor_print_gaps_json() {
  local first="yes" code severity blocking remediation_type can_resume
  printf '['
  while IFS='|' read -r code severity blocking remediation_type can_resume; do
    [ -n "$code" ] || continue
    if [ "$first" = "no" ]; then printf ','; fi
    printf '{"code":'; json_string "$code"; printf ',"severity":'; json_string "$severity"; printf ',"blocking":%s' "$blocking"; printf ',"remediation_type":'; json_string "$remediation_type"; printf ',"auto_resume":%s}' "$can_resume"
    first="no"
  done <<EOF
$DOCTOR_GAPS
EOF
  printf ']'
}

doctor_print_remediation_json() {
  local first="yes" code severity blocking remediation_type can_resume
  printf '['
  while IFS='|' read -r code severity blocking remediation_type can_resume; do
    [ -n "$code" ] || continue
    if [ "$first" = "no" ]; then printf ','; fi
    printf '{"gap_code":'; json_string "$code"; printf ',"type":'; json_string "$remediation_type"; printf ',"auto_resume":%s}' "$can_resume"
    first="no"
  done <<EOF
$DOCTOR_GAPS
EOF
  printf ']'
}

doctor_print_json() {
  local next_action="$1"
  printf '{"schema_version":1,'
  printf '"overall_status":'; json_string "$DOCTOR_OVERALL_STATUS"; printf ','
  printf '"checks":'; doctor_print_checks_json; printf ','
  printf '"capability_gaps":'; doctor_print_gaps_json; printf ','
  printf '"remediation":'; doctor_print_remediation_json; printf ','
  printf '"resume_intent":{"raw":'; json_string "$DOCTOR_INTENT"; printf ',"dispatch_context":'; json_string "$DOCTOR_DISPATCH_CONTEXT"; printf ',"auto_resume":%s}' "$DOCTOR_AUTO_RESUME"
  printf ',"next_action":'; json_string "$next_action"; printf '}\n'
}

doctor_print_human() {
  local next_action="$1"
  local id status detail code severity blocking remediation_type can_resume
  echo "Zimaflow doctor"
  echo "Host: $DOCTOR_HOST"
  echo "Overall status: $DOCTOR_OVERALL_STATUS"
  echo "Checks:"
  while IFS='|' read -r id status detail; do
    [ -n "$id" ] || continue
    echo "- $id: $status ($detail)"
  done <<EOF
$DOCTOR_CHECKS
EOF
  if [ -n "$DOCTOR_GAPS" ]; then
    echo "Capability gaps:"
    while IFS='|' read -r code severity blocking remediation_type can_resume; do
      [ -n "$code" ] || continue
      echo "- $code: $severity, blocking=$blocking, remediation=$remediation_type, auto_resume=$can_resume"
    done <<EOF
$DOCTOR_GAPS
EOF
  else
    echo "Capability gaps: none"
  fi
  echo "Resume intent: ${DOCTOR_INTENT:-none}"
  echo "Next action: $next_action"
}

run_doctor() {
  local host="${1:-}"
  shift || true
  if [ -z "$host" ]; then echo "Missing host for doctor" >&2; return 2; fi

  local output_mode="human" project="$(pwd)" capability="zimaflow.start"
  local cli_path="${BASH_SOURCE[0]}" cli_version="$VERSION" protocol_version="1"
  local runtime_manifest="" permission_status="granted"
  DOCTOR_INTENT=""
  DOCTOR_DISPATCH_CONTEXT=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) output_mode="json"; shift ;;
      --project|--capability|--intent|--dispatch-context|--cli-path|--cli-version|--protocol-version|--runtime-manifest|--permission-status)
        [ "$#" -ge 2 ] || { echo "Missing value for doctor option: $1" >&2; return 2; }
        case "$1" in
          --project) project="$2" ;;
          --capability) capability="$2" ;;
          --intent) DOCTOR_INTENT="$2" ;;
          --dispatch-context) DOCTOR_DISPATCH_CONTEXT="$2" ;;
          --cli-path) cli_path="$2" ;;
          --cli-version) cli_version="$2" ;;
          --protocol-version) protocol_version="$2" ;;
          --runtime-manifest) runtime_manifest="$2" ;;
          --permission-status) permission_status="$2" ;;
        esac
        shift 2
        ;;
      *) echo "Unknown doctor option: $1" >&2; return 2 ;;
    esac
  done
  case "$permission_status" in granted|denied) ;; *) echo "Invalid permission status: $permission_status" >&2; return 2 ;; esac

  local zimaflow_home profile_file capability_file
  zimaflow_home="$(find_zimaflow_home)"
  profile_file="$zimaflow_home/references/host-capabilities.yaml"
  capability_file="$zimaflow_home/references/doctor-capabilities.yaml"
  DOCTOR_HOST="$host"
  DOCTOR_CHECKS=""
  DOCTOR_GAPS=""
  DOCTOR_AUTO_RESUME="true"

  if [ -x "$cli_path" ]; then doctor_add_check "cli" "passed" "cli_present"; else doctor_add_check "cli" "failed" "cli_missing"; doctor_add_gap "cli_missing"; fi
  if [ "$cli_version" = "$VERSION" ]; then doctor_add_check "cli_version" "passed" "cli_version_compatible"; else doctor_add_check "cli_version" "failed" "cli_version_incompatible"; doctor_add_gap "cli_version_incompatible"; fi
  if [ "$protocol_version" = "1" ]; then doctor_add_check "contract" "passed" "protocol_compatible"; else doctor_add_check "contract" "failed" "contract_incompatible"; doctor_add_gap "contract_incompatible"; fi
  local project_context="" p_schema="" p_name="" p_code_root="" p_docs_root="" p_config="" p_projects_file="" p_docs_source="" p_initialized="false"
  project_context="$(resolve_project_context "$project" 2>/dev/null || true)"
  if [ -n "$project_context" ]; then
    IFS=$'\t' read -r p_schema p_name p_code_root p_docs_root p_config p_projects_file p_docs_source p_initialized <<EOF
$project_context
EOF
  fi
  if [ "$p_initialized" = "true" ] && [ -f "$project/openspec/config.yaml" ]; then
    doctor_add_check "project" "passed" "project_initialized"
  else
    doctor_add_check "project" "failed" "project_not_initialized"
    doctor_add_gap "project_not_initialized"
  fi

  local profile_schema support_tier profile_core
  profile_schema="$(yaml_top_value "$profile_file" "schema_version")"
  support_tier="$(yaml_nested_value "$profile_file" "$host" "support_tier")"
  profile_core="$(yaml_nested_value "$profile_file" "core" "logical_skill_ids")"
  if [ "$profile_schema" = "1" ] && [ "$profile_core" = "true" ] && [ -n "$support_tier" ]; then doctor_add_check "host_profile" "passed" "host_profile_resolved"; else doctor_add_check "host_profile" "failed" "host_profile_missing"; doctor_add_gap "host_profile_missing"; fi

  local capability_schema capability_protocol capabilities
  capability_schema="$(yaml_top_value "$capability_file" "schema_version")"
  capability_protocol="$(yaml_top_value "$capability_file" "protocol_version")"
  capabilities="$(yaml_top_value "$capability_file" "logical_capabilities")"
  if [ "$capability_schema" != "1" ] || [ "$capability_protocol" != "1" ]; then
    doctor_add_check "capability" "failed" "contract_incompatible"
    doctor_add_gap "contract_incompatible"
  elif doctor_csv_contains "$capabilities" "$capability"; then
    doctor_add_check "capability" "passed" "capability_resolved"
  else
    doctor_add_check "capability" "failed" "capability_unavailable"
    doctor_add_gap "capability_unavailable"
  fi

  if [ "$permission_status" = "granted" ]; then doctor_add_check "permission" "passed" "permission_granted"; else doctor_add_check "permission" "failed" "permission_denied"; doctor_add_gap "permission_denied"; fi
  if [ -z "$runtime_manifest" ]; then
    doctor_add_check "runtime" "not_requested" "runtime_not_checked"
  elif [ ! -f "$runtime_manifest" ]; then
    doctor_add_check "runtime" "failed" "runtime_missing"
    doctor_add_gap "runtime_missing"
  else
    local runtime_schema runtime_protocol runtime_fingerprint profile_fingerprint
    runtime_schema="$(yaml_top_value "$runtime_manifest" "schema_version")"
    runtime_protocol="$(yaml_top_value "$runtime_manifest" "doctor_contract_schema_version")"
    runtime_fingerprint="$(yaml_top_value "$runtime_manifest" "source_fingerprint")"
    profile_fingerprint="$(hash_file "$profile_file" 2>/dev/null || true)"
    if [ "$runtime_schema" != "1" ] || [ "$runtime_protocol" != "1" ]; then
      doctor_add_check "runtime" "failed" "contract_incompatible"
      doctor_add_gap "contract_incompatible"
    elif [ -z "$profile_fingerprint" ] || [ "$runtime_fingerprint" != "$profile_fingerprint" ]; then
      doctor_add_check "runtime" "failed" "runtime_drift"
      doctor_add_gap "runtime_drift"
    else
      doctor_add_check "runtime" "passed" "runtime_in_sync"
    fi
  fi

  if [ -n "$DOCTOR_GAPS" ]; then DOCTOR_OVERALL_STATUS="blocked"; else DOCTOR_OVERALL_STATUS="ready"; fi
  local next_action
  next_action="$(doctor_next_action)"
  if [ "$output_mode" = "json" ]; then doctor_print_json "$next_action"; else doctor_print_human "$next_action"; fi
}

find_context_index() {
  local dir
  dir="$(pwd)"
  while [ "$dir" != "/" ]; do
    if [ -f "$dir/.zimaflow/context-index.yaml" ]; then
      printf '%s/.zimaflow/context-index.yaml' "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
}

path_is_absolute() {
  case "$1" in
    /*) return 0 ;;
    *) return 1 ;;
  esac
}

resolve_context_path() {
  local docs_dir="$1"
  local path="$2"
  if [ -z "$path" ]; then
    return 0
  fi
  if path_is_absolute "$path"; then
    printf '%s' "$path"
  else
    printf '%s/%s' "$docs_dir" "$path"
  fi
}

state_files() {
  local root="$1"
  local changes_dir="$root/openspec/changes"
  if [ -d "$changes_dir" ]; then
    find "$changes_dir" -mindepth 2 -maxdepth 2 -name .zimaflow-state.yaml -type f -print 2>/dev/null | sort
  fi
}

state_change_from_path() {
  local root="$1"
  local file="$2"
  local changes_dir="$root/openspec/changes"
  local rel="${file#"$changes_dir"/}"
  printf '%s' "${rel%%/*}"
}

state_record() {
  local root="$1"
  local file="$2"
  local fallback_change
  fallback_change="$(state_change_from_path "$root" "$file")"

  local change_id phase mode archive_status
  change_id="$(yaml_top_value "$file" "change_id")"
  phase="$(yaml_top_value "$file" "phase")"
  mode="$(yaml_top_value "$file" "mode")"
  archive_status="$(yaml_nested_value "$file" "archive" "status")"

  [ -n "$change_id" ] || change_id="$fallback_change"
  [ -n "$phase" ] || phase="unknown"
  [ -n "$mode" ] || mode="unknown"
  [ -n "$archive_status" ] || archive_status="unknown"

  printf '%s\t%s\t%s\t%s\t%s\n' "$change_id" "$phase" "$mode" "$archive_status" "$file"
}

state_path_for_change() {
  local root="$1"
  local change="$2"
  printf '%s/openspec/changes/%s/.zimaflow-state.yaml' "$root" "$change"
}

validate_change_id() {
  local change="$1"
  if [ -z "$change" ] || printf '%s' "$change" | grep -Eq '(^\.)|(/)|(^$)'; then
    echo "Invalid change id: $change" >&2
    return 2
  fi
}

now_iso() {
  date '+%Y-%m-%dT%H:%M:%S%z'
}

today_ymd() {
  date '+%Y-%m-%d'
}

cutoff_ymd() {
  local days="$1"
  if date -v-"$days"d '+%Y-%m-%d' >/dev/null 2>&1; then
    date -v-"$days"d '+%Y-%m-%d'
  else
    date -d "$days days ago" '+%Y-%m-%d'
  fi
}

now_epoch() {
  date '+%s'
}

# Extract the YYYY-MM-DD date part from an ISO-like timestamp.
ts_to_ymd() {
  printf '%s' "$1" | sed -n 's/^\([0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}\).*/\1/p'
}

# Convert a YYYY-MM-DD date to epoch seconds (BSD/macOS then GNU fallback).
ymd_to_epoch() {
  local ymd="$1"
  [ -n "$ymd" ] || return 1
  if date -j -f "%Y-%m-%d" "$ymd" '+%s' >/dev/null 2>&1; then
    date -j -f "%Y-%m-%d" "$ymd" '+%s'
  else
    date -d "$ymd" '+%s' 2>/dev/null
  fi
}

# File mtime as epoch seconds (GNU stat then BSD stat fallback).
file_mtime_epoch() {
  local f="$1"
  [ -e "$f" ] || return 1
  stat -c %Y "$f" 2>/dev/null || stat -f %m "$f" 2>/dev/null
}

# Whole days between an epoch value and now (can be 0 or negative on skew).
days_since_epoch() {
  local then_epoch="$1"
  [ -n "$then_epoch" ] || return 1
  local now
  now="$(now_epoch)"
  echo $(( (now - then_epoch) / 86400 ))
}

id_date_ymd() {
  local id="$1"
  local raw
  raw="$(printf '%s' "$id" | sed -n 's/^kf-\([0-9]\{8\}\).*/\1/p')"
  if [ -n "$raw" ]; then
    printf '%s-%s-%s' "${raw%????}" "$(printf '%s' "$raw" | cut -c5-6)" "$(printf '%s' "$raw" | cut -c7-8)"
  fi
}

find_knowledge_root() {
  if [ -f "references/lessons-common.md" ]; then
    pwd
    return 0
  fi
  find_git_root
}

