{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo://references/reviewer-executor-resume-approval.schema.json",
  "title": "Reviewer-Executor Blocked Resume Approval Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision", "approved", "change_id", "objective_id", "round_id", "blocked_event_id", "required_decision_sha256", "approved_scope", "approval_authority", "approved_at"],
  "oneOf": [
    {"required": ["blocker_category", "blocker_code"], "not": {"required": ["blocker_text_sha256"]}},
    {"required": ["blocker_text_sha256"], "not": {"anyOf": [{"required": ["blocker_category"]}, {"required": ["blocker_code"]}]}}
  ],
  "properties": {
    "schema_version": {"const": 1},
    "decision": {"const": "approve_blocked_objective_resume"},
    "approved": {"const": true},
    "change_id": {"type": "string", "minLength": 1},
    "objective_id": {"type": "string", "minLength": 1},
    "round_id": {"type": "string", "pattern": "^round-[0-9]+$"},
    "blocked_event_id": {"type": "string", "minLength": 1},
    "blocker_category": {"type": "string", "minLength": 1},
    "blocker_code": {"type": "string", "minLength": 1},
    "blocker_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "required_decision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approved_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "approval_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "authority_id"],
      "properties": {
        "kind": {"enum": ["user", "reviewer"]},
        "authority_id": {"type": "string", "minLength": 1, "not": {"const": "executor"}}
      }
    },
    "approved_at": {"type": "string", "format": "date-time"}
  }
}
